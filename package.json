{
  "name": "burger-house-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Burger House Tools Monorepo - Backend (.NET 10) & Frontend (React + TypeScript)",
  "scripts": {
    "dev:web": "npm.cmd run dev --prefix burger-house-tools-web",
    "build:web": "npm.cmd run build --prefix burger-house-tools-web",
    "dev:api": "dotnet run --project burger-house-tools-api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
